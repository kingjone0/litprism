{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LitPrism",
  "version": "0.1.0",
  "identifier": "cn.litprism.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "文献棱镜 LitPrism",
        "width": 1360,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/litprism-sidecar.exe"
    ]
  }
}